OPENAI_API_KEY=your_openai_api_key
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
# YouTube sign-in, used only when YouTube asks (age-restricted videos, its "not a bot" check):
# a cookies.txt file, and/or the browser to read your YouTube sign-in from (chrome, brave,
# safari, firefox; "off" to turn it off). The background worker reads browser cookies only
# with YTDLP_COOKIES_IN_WORKER=1.
YTDLP_COOKIES_PATH=
YTDLP_COOKIES_BROWSER=chrome
YTDLP_COOKIES_IN_WORKER=0
# Round 55: clips run 35 s to 3 min and end where the speaker lands the point (no 60 s cap).
# CLIP_LENGTH=legacy goes back to Round 54's 30-60 s clips with the 59 s cap.
CLIP_LENGTH=
# Round 57: the clean (textless) copy for post-production teams. 1: every clip is rendered a
# second time without captions, title card, data cards or lower third, into <clip>_clean/ with
# the .srt, the dialogue (24-bit WAV) and any sound effect as its own stem. Doubles render time.
# TEXTLESS_PRORES=1 makes that copy a ProRes 422 HQ .mov (large files) instead of H.264.
TEXTLESS_MASTER=0
TEXTLESS_PRORES=0
